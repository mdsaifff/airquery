{
  "$defs": {
    "CameraTarget": {
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "lat",
        "lon",
        "label"
      ],
      "title": "CameraTarget",
      "type": "object"
    },
    "Column": {
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "number",
            "text",
            "timestamp"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "synonyms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        },
        "examples": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        },
        "categorical": {
          "default": false,
          "title": "Categorical",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Column",
      "type": "object"
    },
    "CompileRequest": {
      "description": "POST /compile: a spec built in the UI (mouse baseline) -> validated SQL, no LLM.",
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/QuerySpec"
        }
      },
      "required": [
        "dataset",
        "spec"
      ],
      "title": "CompileRequest",
      "type": "object"
    },
    "DatasetSchema": {
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "default": "id",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "discriminator": {
            "mapping": {
              "geo": "#/$defs/GeoPosition",
              "xyz": "#/$defs/XyzPosition"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GeoPosition"
            },
            {
              "$ref": "#/$defs/XyzPosition"
            }
          ],
          "title": "Position"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 64,
          "title": "Columns",
          "type": "array"
        },
        "default_color_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Color By"
        },
        "default_size_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Size By"
        },
        "row_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        }
      },
      "required": [
        "dataset",
        "table",
        "description",
        "position",
        "columns"
      ],
      "title": "DatasetSchema",
      "type": "object"
    },
    "ExplainRequest": {
      "description": "POST /explain: ids of the selected points -> aggregate SQL (computed in DuckDB).",
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "dataset_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dataset",
        "ids",
        "dataset_schema"
      ],
      "title": "ExplainRequest",
      "type": "object"
    },
    "Filter": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "between",
            "in",
            "contains",
            "last_days"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "title": "Filter",
      "type": "object"
    },
    "GeoPosition": {
      "properties": {
        "kind": {
          "const": "geo",
          "title": "Kind",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "string"
        },
        "lon": {
          "title": "Lon",
          "type": "string"
        },
        "depth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth"
        },
        "height": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        }
      },
      "required": [
        "kind",
        "lat",
        "lon"
      ],
      "title": "GeoPosition",
      "type": "object"
    },
    "Pointer": {
      "description": "The globe point under the user's hand or mouse when they spoke (\"here\").",
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Pointer",
      "type": "object"
    },
    "QueryRequest": {
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "utterance": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Utterance",
          "type": "string"
        },
        "current_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuerySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pointer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Scene"
          },
          "maxItems": 32,
          "title": "Scenes",
          "type": "array"
        },
        "dataset_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dataset",
        "utterance",
        "current_spec",
        "pointer",
        "scenes",
        "dataset_schema"
      ],
      "title": "QueryRequest",
      "type": "object"
    },
    "QueryResponse": {
      "properties": {
        "status": {
          "enum": [
            "ok",
            "clarify",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuerySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sql": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sql"
        },
        "params": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "array"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "timings_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "title": "Timings Ms",
          "type": "object"
        }
      },
      "required": [
        "status",
        "spec",
        "sql",
        "params",
        "message",
        "retries",
        "timings_ms"
      ],
      "title": "QueryResponse",
      "type": "object"
    },
    "QuerySpec": {
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "intent": {
          "default": "query",
          "enum": [
            "query",
            "navigate",
            "undo",
            "reset",
            "explain",
            "timeline",
            "view",
            "switch"
          ],
          "title": "Intent",
          "type": "string"
        },
        "mode": {
          "default": "refine",
          "enum": [
            "refine",
            "replace"
          ],
          "title": "Mode",
          "type": "string"
        },
        "filters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "title": "Filters",
          "type": "array"
        },
        "color_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color By"
        },
        "size_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size By"
        },
        "sort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "camera_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timeline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timeline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "view": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewChange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "switch_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Switch To"
        }
      },
      "required": [
        "version",
        "dataset",
        "intent",
        "mode",
        "filters",
        "color_by",
        "size_by",
        "sort",
        "limit",
        "camera_target",
        "timeline",
        "view",
        "switch_to"
      ],
      "title": "QuerySpec",
      "type": "object"
    },
    "Scene": {
      "description": "A scene the browser can show (built-in or a user's CSV), for \"switch to ...\" requests.",
      "properties": {
        "name": {
          "maxLength": 64,
          "title": "Name",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "name",
        "title"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Sort": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "direction": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "field",
        "direction"
      ],
      "title": "Sort",
      "type": "object"
    },
    "Timeline": {
      "description": "A time machine command: play / pause / stop the year replay, seek, or change speed.",
      "properties": {
        "action": {
          "enum": [
            "play",
            "pause",
            "stop",
            "seek",
            "speed"
          ],
          "title": "Action",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "speed": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed"
        }
      },
      "required": [
        "action",
        "date",
        "speed"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "ViewChange": {
      "description": "Display switches; set only what changes.",
      "properties": {
        "xray": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xray"
        },
        "stats": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stats"
        },
        "share": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share"
        },
        "mute": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mute"
        }
      },
      "required": [
        "xray",
        "stats",
        "share",
        "mute"
      ],
      "title": "ViewChange",
      "type": "object"
    },
    "XyzPosition": {
      "description": "Points already laid out in 3D (e.g. a UMAP of embeddings), scene units ~[-1, 1].",
      "properties": {
        "kind": {
          "const": "xyz",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "string"
        },
        "y": {
          "title": "Y",
          "type": "string"
        },
        "z": {
          "title": "Z",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "z"
      ],
      "title": "XyzPosition",
      "type": "object"
    }
  },
  "title": "AirQueryContracts"
}
