{
  "$defs": {
    "CameraTarget": {
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "lat",
        "lon",
        "label"
      ],
      "title": "CameraTarget",
      "type": "object"
    },
    "Column": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "number",
            "text",
            "timestamp"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "synonyms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        },
        "examples": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Column",
      "type": "object"
    },
    "DatasetSchema": {
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "default": "id",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/GeoPosition"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "title": "Columns",
          "type": "array"
        },
        "default_color_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Color By"
        },
        "default_size_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Size By"
        },
        "row_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        }
      },
      "required": [
        "dataset",
        "table",
        "description",
        "position",
        "columns"
      ],
      "title": "DatasetSchema",
      "type": "object"
    },
    "Filter": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "between",
            "in",
            "contains",
            "last_days"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "title": "Filter",
      "type": "object"
    },
    "GeoPosition": {
      "properties": {
        "kind": {
          "const": "geo",
          "title": "Kind",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "string"
        },
        "lon": {
          "title": "Lon",
          "type": "string"
        },
        "depth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth"
        }
      },
      "required": [
        "kind",
        "lat",
        "lon"
      ],
      "title": "GeoPosition",
      "type": "object"
    },
    "QueryRequest": {
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "utterance": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Utterance",
          "type": "string"
        },
        "current_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuerySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dataset",
        "utterance",
        "current_spec"
      ],
      "title": "QueryRequest",
      "type": "object"
    },
    "QueryResponse": {
      "properties": {
        "status": {
          "enum": [
            "ok",
            "clarify",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuerySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sql": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sql"
        },
        "params": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "array"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "timings_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "title": "Timings Ms",
          "type": "object"
        }
      },
      "required": [
        "status",
        "spec",
        "sql",
        "params",
        "message",
        "retries",
        "timings_ms"
      ],
      "title": "QueryResponse",
      "type": "object"
    },
    "QuerySpec": {
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "intent": {
          "default": "query",
          "enum": [
            "query",
            "navigate",
            "undo",
            "reset",
            "explain"
          ],
          "title": "Intent",
          "type": "string"
        },
        "mode": {
          "default": "refine",
          "enum": [
            "refine",
            "replace"
          ],
          "title": "Mode",
          "type": "string"
        },
        "filters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "title": "Filters",
          "type": "array"
        },
        "color_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color By"
        },
        "size_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size By"
        },
        "sort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "camera_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "version",
        "dataset",
        "intent",
        "mode",
        "filters",
        "color_by",
        "size_by",
        "sort",
        "limit",
        "camera_target"
      ],
      "title": "QuerySpec",
      "type": "object"
    },
    "Sort": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "direction": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "field",
        "direction"
      ],
      "title": "Sort",
      "type": "object"
    }
  },
  "title": "AirQueryContracts"
}
