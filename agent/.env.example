# Copy to agent/.env and fill in. Never commit agent/.env.
# Provider and model are chosen in task T3.4.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Where DatasetSchema files live (written by `make data`)
SCHEMA_DIR=../web/public/data

# Frontend origins allowed by CORS (comma-separated): dev server, vite preview, production
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Requests per minute per IP on /query
RATE_LIMIT_PER_MIN=30
