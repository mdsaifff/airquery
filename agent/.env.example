# Copy to agent/.env and fill in. Never commit agent/.env.
# LLM: Claude via the Anthropic SDK. LLM_MODEL defaults to claude-opus-5-5
# (cheaper/faster tiers for ablations: claude-sonnet-5-5, claude-haiku-5-5).
# LLM_API_KEY may stay empty if ANTHROPIC_API_KEY is set or `ant auth login` was run.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=

# Where DatasetSchema files live (written by `make data`)
SCHEMA_DIR=../web/public/data

# Frontend origins allowed by CORS (comma-separated): dev server, vite preview, production
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Requests per minute per IP on /query
RATE_LIMIT_PER_MIN=30
